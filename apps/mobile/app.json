{
  "expo": {
    "name": "TeddySteps",
    "slug": "teddysteps",
    "scheme": "teddysteps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "nl.teddysteps.app",
      "supportsTablet": false
    },
    "android": {
      "package": "nl.teddysteps.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2ECE1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "TeddySteps gebruikt alleen de foto’s die je zelf kiest voor een moment.",
          "cameraPermission": "Met de camera maak je meteen een foto voor een moment op het pad.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
