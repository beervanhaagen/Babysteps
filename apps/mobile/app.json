{
  "expo": {
    "name": "TeddySteps",
    "slug": "teddysteps",
    "scheme": "teddysteps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "nl.teddysteps.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nl.teddysteps.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFD84D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "TeddySteps gebruikt alleen de foto’s die je zelf kiest voor een moment.",
          "cameraPermission": "Met de camera maak je meteen een foto voor een moment op het pad.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "knuffels"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Zo kan TeddySteps foto’s van je pad in je fotobibliotheek zetten.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4a006965-5f05-46c8-b8b2-d723ec5acaf6"
      }
    },
    "owner": "beervanhaagen"
  }
}
